# Copy to .env and fill in. Never commit .env.

# Tier 1: Muse Spark Open on Baseten (OpenAI-compatible)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
# low keeps the always-on narrator fast (~1-2s per call)
BASETEN_REASONING_EFFORT=low

# Tier 2: Muse Spark via Meta Model API (OpenAI-compatible)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# leave empty for the model default (best for the CaseJudge)
META_REASONING_EFFORT=

# Optional fallback provider
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=

# Family alerts (Stage F)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAMILY_PHONE_NUMBER=

# Backend / family dashboard (Stage F). Leave the tokens empty to have them
# generated locally into runtime/backend/keys.json.
TRIPWIRE_BACKEND_URL=http://127.0.0.1:8765
TRIPWIRE_PUBLIC_URL=http://127.0.0.1:8765
TRIPWIRE_AGENT_TOKEN=
TRIPWIRE_DASHBOARD_KEY=

# Spoken warnings: Google Cloud Text-to-Speech (uses gcloud application-default credentials)
TRIPWIRE_VOICE=en-US-Chirp3-HD-Vindemiatrix
TRIPWIRE_SPEAKING_RATE=0.92
TRIPWIRE_GCP_PROJECT=nixora-project
