# Copy to .env and fill in. Never commit .env.
#
# ONLY META_API_KEY IS REQUIRED. Everything else is optional and adds one thing.

# ---- Required -------------------------------------------------------------------------
# Meta Model API key (dev.meta.ai). Used for Muse Spark, Muse Wonder, Muse Image,
# Muse Voice Transcribe and SAM 3.1.
META_API_KEY=

# ---- Optional: models ------------------------------------------------------------------
# Muse Spark Open on Baseten for the always-on analysts and the reviewer.
# Leave empty and those roles use Muse Spark on the Meta Model API instead.
BASETEN_API_KEY=

# Defaults, only change them if you need to:
# META_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3
# META_REASONING_EFFORT=low
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# BASETEN_MODEL=meta-models/muse-spark-open-1026
# WONDER_MODEL=muse-wonder-1.0

# Tripwire Sentinel (our fine-tuned Llama 3.2 1B, served on Modal). Without a Modal
# login (`modal setup`) or these tokens, Sentinel is skipped and the judge decides alone.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# TRIPWIRE_SENTINEL=0          # set to 0 to turn Sentinel off even with a Modal login

# ---- Optional: voices ------------------------------------------------------------------
# Spoken warnings and Margaret's voice use Google Cloud Text-to-Speech (Chirp 3 HD) with
# your gcloud application-default credentials. Without them, the live scam test is text only.
# TRIPWIRE_GCP_PROJECT=your-google-cloud-project
# TRIPWIRE_VOICE=en-US-Chirp3-HD-Vindemiatrix
# TRIPWIRE_SPEAKING_RATE=0.92

# ---- Optional: local family pages -----------------------------------------------------
# 1 lets you open the family dashboard (/family) locally without a key.
# Otherwise its key is generated into runtime/backend/keys.json.
TRIPWIRE_PUBLIC_DASHBOARD=1
# TRIPWIRE_PUBLIC_URL=http://127.0.0.1:8765
# TRIPWIRE_BACKEND_URL=http://127.0.0.1:8765
# TRIPWIRE_AGENT_TOKEN=
# TRIPWIRE_DASHBOARD_KEY=

# ---- Optional: phone line and texts (Twilio) -------------------------------------------
# Without these, family texts are shown on the incident page as "demo mode: not sent".
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# FAMILY_PHONE_NUMBER=
# TRIPWIRE_PHONE_MODE=margaret   # or protect (needs PROTECTED_PHONE_NUMBER)
# PROTECTED_PHONE_NUMBER=
